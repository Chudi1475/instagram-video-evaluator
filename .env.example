# Required for the evaluation step
ANTHROPIC_API_KEY=sk-ant-...

# Required only if IGV_TRANSCRIBE_BACKEND=groq (the default)
GROQ_API_KEY=gsk_...

# --- Optional overrides (defaults shown) ---
# IGV_TRANSCRIBE_BACKEND=groq        # or "local" for offline faster-whisper
# IGV_ANTHROPIC_MODEL=claude-sonnet-4-6
# IGV_FRAME_FPS=1.0
# IGV_PHASH_THRESHOLD=6
# IGV_MAX_FRAMES=30
